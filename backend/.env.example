# MessHunt Backend Environment Configuration
PORT=5000

# MongoDB Connection String (Atlas or Local MongoDB)
# Example for local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/messhunt
# Example for MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/test?retryWrites=true&w=majority

# Optional: JWT Secret (falls back to a default if omitted)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Optional: Secret key to create an Admin account during registration
# ADMIN_SETUP_KEY=your_admin_secret_key

